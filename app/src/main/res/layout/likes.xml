<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#333333"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/white_border"
                android:padding="3dp"
                app:srcCompat="@drawable/outback"
                tools:layout_editor_absoluteX="4dp"
                tools:layout_editor_absoluteY="16dp"
                tools:ignore="MissingConstraints" />

            <SearchView
                android:id="@+id/searchView"
                android:layout_width="315dp"
                android:layout_height="35dp"
                android:background="@drawable/likes"
                android:iconifiedByDefault="false"
                android:layout_marginStart="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:queryHint="Tìm bài hát..."
                app:iconTint="@android:color/white"
                tools:layout_editor_absoluteX="61dp"
                tools:layout_editor_absoluteY="16dp"
                tools:ignore="MissingConstraints" />

        </LinearLayout>

        <TextView
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15sp"
            android:text="Your Likes"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/shufflebutton"
                android:layout_marginLeft="255dp" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10sp"
                android:src="@drawable/play" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15sp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="62dp"
                android:layout_height="57dp"
                app:srcCompat="@drawable/vũ"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="20dp"
                tools:layout_editor_absoluteY="282dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bình Yên/Vũ.ft. Binz "
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10sp"
                    tools:layout_editor_absoluteX="100dp"
                    tools:layout_editor_absoluteY="283dp"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vũ"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10sp"
                    tools:layout_editor_absoluteX="102dp"
                    tools:layout_editor_absoluteY="317dp"
                    tools:ignore="MissingConstraints" />
            </LinearLayout>






        </LinearLayout>



    </LinearLayout>
</ScrollView>