<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#333333"
    android:orientation="vertical"
    tools:ignore="MissingConstraints">


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="50dp"
        tools:layout_editor_absoluteX="22dp"
        android:layout_marginBottom="35dp"
        tools:layout_editor_absoluteY="22dp">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/white_border"
            android:padding="3dp"
            android:layout_marginStart="28dp"
            app:srcCompat="@drawable/outback"
            tools:layout_editor_absoluteX="40dp"
            tools:layout_editor_absoluteY="16dp"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="296sp"
            android:background="@drawable/white_border"
            android:padding="3dp"
            app:srcCompat="@drawable/dot"
            tools:layout_editor_absoluteX="40dp"
            tools:layout_editor_absoluteY="16dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp">

        <ImageView
            android:id="@+id/base_image"
            android:layout_width="412dp"
            android:layout_height="167dp"
            android:scaleType="center"
            android:src="@drawable/bg"
            tools:ignore="ContentDescription,VisualLintBounds" />

        <androidx.cardview.widget.CardView
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardCornerRadius="30dp"
            android:layout_alignTop="@+id/base_image"
            android:layout_gravity="left"
            android:layout_margin="33dp"
            android:layout_marginRight="30dp"
            tools:ignore="ObsoleteLayoutParam,RtlHardcoded">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/hoso"
                tools:ignore="ContentDescription,ImageContrastCheck" />

        </androidx.cardview.widget.CardView>

        <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="110dp"
                android:text="Nghiêm Tổng/ MCK "
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="22sp"
            tools:ignore="HardcodedText,RtlHardcoded" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="69sp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            app:srcCompat="@drawable/marklist"
            tools:ignore="ContentDescription" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="15sp"
            android:layout_marginLeft="200dp"
            android:src="@drawable/shu"
            tools:ignore="ContentDescription,RtlHardcoded" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="15sp"
            android:layout_marginStart="10sp"
            android:src="@drawable/play"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <TextView
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15sp"
        android:layout_marginStart="25sp"
        android:text="Playlists"
        android:textColor="@color/white"
        android:textSize="25sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />


</LinearLayout>

