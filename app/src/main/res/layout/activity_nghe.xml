<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1DB954"
    android:padding="24dp">

    <!-- Ảnh đĩa nhạc -->
    <ImageView
        android:id="@+id/image_alb"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/mck"
        android:layout_marginBottom="40dp"
        android:scaleType="centerCrop" />

    <!-- Tên bài hát -->
    <TextView
        android:id="@+id/text_song_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chìm Sâu"
        android:textColor="#FFFFFF"
        android:textSize="29sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Tên nghệ sĩ -->
    <TextView
        android:id="@+id/text_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MCK"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <!-- Thanh tiến trình -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="30"
        android:max="100"
        android:progressTint="#FFFFFF"
        android:thumbTint="#000000"
        android:layout_marginBottom="35dp" />

    <!-- Thời gian -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="space_between"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/text_time_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:30"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_time_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:35"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Nút điều khiển -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_prev"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_play"
            android:tint="#1DB954"
            android:layout_marginHorizontal="16dp" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_next"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
